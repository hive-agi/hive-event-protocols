{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}

        ;; FSM engine — compile, run, sub-FSM composition, FX
        io.github.hive-agi/hive-events {:mvn/version "0.5.10"}

        ;; Result ADT — ok/err railway for handler returns
        io.github.hive-agi/hive-dsl {:mvn/version "0.5.21"}}

 :aliases
 {
  ;; :build — tools.build entrypoint (clojure -T:build <task>). Canonical hive
  ;; build: jar / jar-aot / install / bump / verify-license / deploy.
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.11"}}
          :ns-default hive-build.api}
:test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.hive-agi/hive-test {:mvn/version "0.4.0"}}}

  :dev {:extra-paths ["dev"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}
                     cider/cider-nrepl {:mvn/version "0.62.2"}}}}}
