{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}

        ;; FSM engine — compile, run, sub-FSM composition, FX
        io.github.hive-agi/hive-events {:mvn/version "0.6.1"}

        ;; Result ADT — ok/err railway for handler returns
        io.github.hive-agi/hive-dsl {:mvn/version "0.6.2"}

        ;; Function contracts (m/=>) — the single source for shapes + tests
        metosin/malli {:mvn/version "0.20.3"}}

 :aliases
 {
  ;; :build — tools.build entrypoint (clojure -T:build <task>). Canonical hive
  ;; build: jar / jar-aot / install / bump / verify-license / deploy.
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.3.1"}}
          :ns-default hive-build.api}
:test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                      org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.hive-agi/hive-test {:mvn/version "0.5.2"}
                      io.github.hive-agi/hive-schemas {:mvn/version "0.2.2"}}}

  :dev {:extra-paths ["dev"]
        :extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}
                     cider/cider-nrepl {:mvn/version "0.62.2"}}}}}
